		lineageTag: b52f8515-25fb-4632-b132-d60b9edeced0

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Last_month_sales = CALCULATE([Total_sales],DATEADD(date_sales[date_sales_id],-1,MONTH))
