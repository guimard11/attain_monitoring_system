table success_profile
	lineageTag: 068d064c-6b12-4a6e-b883-609cb5d4a675
	sourceLineageTag: [dbo].[success_profile]

	measure Total_SME_loan_approved =
			
			CALCULATE(
			    COUNTROWS(success_profile),
			    success_profile[financial_institution] = "yes"
			)
		formatString: 0
		displayFolder: KPIs
		lineageTag: 6d457193-71c1-477b-96ce-ea69b09b9f0e

		changedProperty = Name

		changedProperty = DisplayFolder

	measure Total_MSMEs = COUNTROWS(success_profile)
		formatString: 0
		displayFolder: KPIs
		lineageTag: 8113b52c-1550-46ee-9a4b-7f4eb62f3c48

		changedProperty = Name

		changedProperty = DisplayFolder

	measure MSME_target = 1.1*[Total_MSMEs]
		displayFolder: KPIs
		lineageTag: f922d275-65ea-4517-8d1b-5d559908d8c4

		changedProperty = DisplayFolder

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

